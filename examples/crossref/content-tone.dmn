<?xml version="1.0" encoding="UTF-8"?>
<!-- One of a small set of files under examples/crossref/ demonstrating
     publish-tree's BPMN<->DMN cross-referencing across multiple files -
     content-approval.bpmn and editorial-review.bpmn both call this
     decision (by its id, "content_tone" - never by filename), so its
     rendered page should show a "Used by" line naming both processes. -->
<definitions xmlns="https://www.omg.org/spec/DMN/20191111/MODEL/" id="d1" name="Content Tone" namespace="http://example.com" exporter="Camunda Modeler" exporterVersion="5.0.0">
  <decision id="content_tone" name="Content Tone">
    <decisionTable id="dt1">
      <input id="in1" label="Word count">
        <inputExpression id="ie1" typeRef="number">
          <text>wordCount</text>
        </inputExpression>
      </input>
      <output id="out1" label="Tone" name="tone" typeRef="string" />
      <rule id="r1">
        <inputEntry id="ie2"><text>&lt;500</text></inputEntry>
        <outputEntry id="oe1"><text>"casual"</text></outputEntry>
      </rule>
      <rule id="r2">
        <inputEntry id="ie3"><text>&gt;=500</text></inputEntry>
        <outputEntry id="oe2"><text>"formal"</text></outputEntry>
      </rule>
    </decisionTable>
  </decision>
</definitions>
