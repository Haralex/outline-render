<?xml version="1.0" encoding="UTF-8"?>
<!-- Adapted from a real Camunda 8 / Zeebe process used by this org
     (geo-automation/processes/blog-approval.bpmn), not copied verbatim -
     task names/types are genericized to a plain CMS draft -> approval ->
     publish flow rather than naming the specific real service involved.
     The element shapes (serviceTask + zeebe:taskDefinition,
     intermediateCatchEvent + messageEventDefinition, exclusiveGateway,
     multiple endEvents) are unchanged from the real file, which is what
     this renderer was actually built and tested against - see
     src/renderers/bpmn.ts's docstring. -->
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  xmlns:zeebe="http://camunda.org/schema/zeebe/1.0"
                  xmlns:modeler="http://camunda.org/schema/modeler/1.0"
                  id="Definitions_1"
                  targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="Camunda Modeler"
                  exporterVersion="5.0.0">

  <bpmn:process id="content-approval" name="Content Approval" isExecutable="true">

    <bpmn:startEvent id="StartEvent_1" name="Content submitted">
      <bpmn:outgoing>Flow_start_to_draft</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:serviceTask id="Task_PostDraft" name="Post draft to CMS">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="post-draft-to-cms" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_start_to_draft</bpmn:incoming>
      <bpmn:outgoing>Flow_draft_to_email</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:serviceTask id="Task_SendApprovalEmail" name="Send approval email">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="send-approval-email" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_draft_to_email</bpmn:incoming>
      <bpmn:outgoing>Flow_email_to_catch</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:intermediateCatchEvent id="Event_WaitApproval" name="Wait for approval">
      <bpmn:incoming>Flow_email_to_catch</bpmn:incoming>
      <bpmn:outgoing>Flow_catch_to_gateway</bpmn:outgoing>
      <bpmn:messageEventDefinition id="MessageEventDefinition_1" messageRef="Message_Approval" />
    </bpmn:intermediateCatchEvent>

    <bpmn:exclusiveGateway id="Gateway_Approved" name="Approved?">
      <bpmn:incoming>Flow_catch_to_gateway</bpmn:incoming>
      <bpmn:outgoing>Flow_approved</bpmn:outgoing>
      <bpmn:outgoing>Flow_rejected</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:serviceTask id="Task_PublishContent" name="Publish content">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="publish-content" retries="3" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_approved</bpmn:incoming>
      <bpmn:outgoing>Flow_publish_to_end</bpmn:outgoing>
    </bpmn:serviceTask>

    <bpmn:endEvent id="EndEvent_Published" name="Content published">
      <bpmn:incoming>Flow_publish_to_end</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:endEvent id="EndEvent_Rejected" name="Content rejected">
      <bpmn:incoming>Flow_rejected</bpmn:incoming>
    </bpmn:endEvent>

    <bpmn:sequenceFlow id="Flow_start_to_draft" sourceRef="StartEvent_1" targetRef="Task_PostDraft" />
    <bpmn:sequenceFlow id="Flow_draft_to_email" sourceRef="Task_PostDraft" targetRef="Task_SendApprovalEmail" />
    <bpmn:sequenceFlow id="Flow_email_to_catch" sourceRef="Task_SendApprovalEmail" targetRef="Event_WaitApproval" />
    <bpmn:sequenceFlow id="Flow_catch_to_gateway" sourceRef="Event_WaitApproval" targetRef="Gateway_Approved" />
    <bpmn:sequenceFlow id="Flow_approved" name="Yes" sourceRef="Gateway_Approved" targetRef="Task_PublishContent">
      <bpmn:conditionExpression>=approved = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_rejected" name="No" sourceRef="Gateway_Approved" targetRef="EndEvent_Rejected">
      <bpmn:conditionExpression>=approved = false</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_publish_to_end" sourceRef="Task_PublishContent" targetRef="EndEvent_Published" />

  </bpmn:process>

  <bpmn:message id="Message_Approval" name="approval-decision">
    <bpmn:extensionElements>
      <zeebe:subscription correlationKey="=processInstanceKey" />
    </bpmn:extensionElements>
  </bpmn:message>

</bpmn:definitions>
