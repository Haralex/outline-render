# Copy to .env and fill in - .env is gitignored, never commit real values.

# Settings -> API in Outline. Scope this to a dedicated service account
# once this runs unattended (e.g. in CI), rather than a personal account.
OUTLINE_API_KEY=ol_api_...

# Only needed if publishing to something other than the default instance.
OUTLINE_API_URL=https://app.getoutline.com/api

# Default collection name for `publish`/`delete-collection` when --collection
# isn't passed explicitly. Optional - both commands still take --collection.
OUTLINE_COLLECTION=
